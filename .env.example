# Copy to .env (gitignored). Every value is optional; defaults shown.
# No credentials are needed: OULAD is a public download and every AWS service is emulated locally.

# Lake root: raw/, warehouse/ (Iceberg), warehouse.duckdb, ops/
EDTECH_DATA_DIR=data

# Source (figshare record cited by the OULAD paper; UCI mirror as fallback)
# EDTECH_SOURCE_URL=https://ndownloader.figshare.com/files/8606371
# EDTECH_SOURCE_MD5=7412686fd77cf0e0ee1e8c3e9b354308
# EDTECH_FALLBACK_URL=https://archive.ics.uci.edu/static/public/349/open+university+learning+analytics+dataset.zip
EDTECH_HTTP_TIMEOUT_SECONDS=120
EDTECH_HTTP_RETRIES=4

# Local Spark (EMR Serverless stand-in)
EDTECH_SPARK_MASTER=local[*]
EDTECH_SPARK_DRIVER_MEMORY=4g
EDTECH_SPARK_SHUFFLE_PARTITIONS=16
EDTECH_SPARK_LOG_LEVEL=WARN
# EDTECH_SPARK_JARS_DIR=   # pre-fetched Iceberg jar directory instead of Maven Central
EDTECH_SILVER_NAMESPACE=silver

# Analytics parameters
EDTECH_HOLDOUT_PRESENTATION=2014J
EDTECH_RISK_CUTOFF_DAY=28
EDTECH_MASTERY_THRESHOLD=70

# Behaviour
EDTECH_DQ_FAIL_ON_ERROR=true
EDTECH_LOG_LEVEL=INFO
EDTECH_LOG_FORMAT=text

# Only for `edtech land-s3` against LocalStack (CI) - never real keys here.
# AWS_ENDPOINT_URL=http://localhost:4566
